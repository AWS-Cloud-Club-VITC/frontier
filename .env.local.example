# Copy this file to .env.local and fill in the two values from your Supabase
# project: Dashboard → Project Settings → Data API (and API Keys).
#
# Both are safe to expose in the browser — row-level security is what protects
# the data, not the key. Never put the service_role key in this file.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Only needed for a subpath deploy (e.g. awscloudclubvit.in/frontier) — see
# SETUP.md section 7.
#NEXT_PUBLIC_BASE_PATH=/frontier
